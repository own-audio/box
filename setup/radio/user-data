#cloud-config
# own.audio radio: first boot of Raspberry Pi OS Lite on the Pi Zero 2 W.
# scripts/prepare-sd.sh fills in the SSH key and writes network-config next to this.
hostname: ownbox-radio
manage_etc_hosts: true
timezone: @TIMEZONE@

users:
  - name: @USER@
    gecos: @USER@
    groups: [adm, dialout, cdrom, sudo, audio, video, plugdev, games, users, input, render, netdev, gpio, i2c, spi]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - SSH_KEY

ssh_pwauth: false

runcmd:
  - [systemctl, enable, --now, ssh]
  - [bash, /boot/firmware/ownbox/firstboot.sh]

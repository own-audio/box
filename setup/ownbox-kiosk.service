[Unit]
Description=own.audio box kiosk (Chromium in cage on tty1)
After=systemd-user-sessions.service plymouth-quit-wait.service
Conflicts=getty@tty1.service
After=getty@tty1.service ownbox.service

[Service]
# No screen connected (a box without one): no kiosk, instead of a restart every 3 s.
# ownbox-boot has already looked (headless = true/false in config.toml); reading the
# connectors again could hang: on a Pi 4 started from a power supply it took over 90 s,
# systemd gave up and the screen stayed black. Only a box set up by hand looks here, and
# not for longer than 5 s.
ExecCondition=/bin/sh -c 'c=/home/@USER@/.config/ownbox/config.toml; grep -qx "headless = false" "$$c" 2>/dev/null && exit 0; grep -qx "headless = true" "$$c" 2>/dev/null && exit 1; timeout 5 grep -qsx connected /sys/class/drm/card*-*/status'
User=@USER@
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
EnvironmentFile=-/etc/default/ownbox-kiosk
# A transparent cursor theme (setup/blank-cursor.py): cage's own pointer stays invisible.
Environment=XCURSOR_PATH=/opt/ownbox/cursors
# A power cut leaves Chromium's profile lock behind; Chromium then takes it for another
# Chromium running, quits at once (code 21), and the kiosk gives up after a few tries.
# The profile is incognito: nothing in it is worth the lock.
ExecStartPre=/bin/sh -c 'rm -f /home/@USER@/.config/chromium/SingletonLock /home/@USER@/.config/chromium/SingletonCookie /home/@USER@/.config/chromium/SingletonSocket'
# Give ownbox up to 30 s to listen, so the first page is the UI and not an error.
ExecStartPre=/bin/bash -c 'for i in {1..30}; do (exec 3<>/dev/tcp/127.0.0.1/8686) 2>/dev/null && exit 0; sleep 1; done; exit 0'
# The page zoom for the panel is in Chromium's Preferences (boot-config.sh).
# --password-store=basic keeps Chromium away from a keyring, which would ask
# for a password at every start. --incognito keeps its cache and profile in RAM:
# nothing the UI needs is stored by the browser, and the SD card is spared the writes.
# While Chromium starts (seconds on a Pi 3) the start-up screen's picture stays up: mpv (the
# box has it already) shows still.png as a window of its own, at its own size like the start-up
# screen, and Chromium opens over it; mpv goes after 90 s. Without a picture it just fails.
ExecStart=/usr/bin/cage -s -- /bin/sh -c '\
  mpv --no-config --really-quiet --vo=gpu --gpu-context=wayland --fs --video-unscaled=yes \
    --no-audio --image-display-duration=90 --background-color=#000000 --no-osc \
    --no-input-default-bindings --cursor-autohide=always \
    /usr/share/plymouth/themes/ownbox/still.png >/dev/null 2>&1 & \
  exec /usr/bin/chromium --kiosk --noerrdialogs \
  --disable-infobars --no-first-run --password-store=basic --incognito \
  --disable-features=Translate --check-for-update-interval=31536000 \
  --ozone-platform=wayland ${KIOSK_URL}'
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target

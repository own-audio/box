[Unit]
Description=own.audio box player (ownbox)
# Five failed starts in two minutes and systemd gives up on it; ownbox-recover then puts
# back the previous version if an update came in the last day, and starts it again either
# way (see install-update.sh recover). Without a limit a broken update looped for good.
StartLimitIntervalSec=120
StartLimitBurst=5
OnFailure=ownbox-recover.service
# Not waiting for the network: ownbox copes with a server out of reach (the screen says
# so and clears it), and waiting cost ~5.5 s of every boot.
After=sound.target

[Service]
User=@USER@
SupplementaryGroups=audio video input
# Port 80 as well, for http://ownbox.local without a port and the setup Wi-Fi's page.
AmbientCapabilities=CAP_NET_BIND_SERVICE
RuntimeDirectory=ownbox
ExecStart=/opt/ownbox/ownbox
Environment=RUST_LOG=ownbox=info
# SIGTERM to ownbox alone first: it reads mpv's position and saves it before stopping
# mpv itself. With the default (control-group) mpv died at once and the position was lost.
KillMode=mixed
TimeoutStopSec=20
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
